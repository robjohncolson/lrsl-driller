# Shared Supabase credentials (service role recommended for Railway writes)
SUPABASE_URL=https://your-shared-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-shared-service-role-key
# Optional fallback for read-only/local testing:
SUPABASE_ANON_KEY=your-shared-anon-key

# Server port (Railway sets this automatically)
PORT=3000

# Optional: Teacher password for admin features
TEACHER_PASSWORD=teacherpass

# Shared grading proxy
GRADING_PROXY_URL=https://shared-grading-proxy-production.up.railway.app
