  "hints": {
    "perField": {
      "vocabAnswer": "A zero is an x-value that makes f(x) = 0, where the graph meets the x-axis. Multiplicity comes from the exponent on a repeated factor.",
      "zeroChoice": "Set the factor equal to zero and solve. For (x - a) = 0, x = a. For (x + a) = 0, x = -a.",
      "multChoice": "Multiplicity is the exponent on the factor. In (x - a)^k, the zero x = a has multiplicity k.",
      "crossTouch": "Odd multiplicity means the graph crosses the x-axis. Even multiplicity means it touches and turns around.",
      "zerosText": "Step 1: factor out the GCF. Step 2: factor the remaining quadratic. Step 3: set each factor equal to zero.",
      "reportText": "For each factor (x - a)^k: the zero is x = a, the multiplicity is k, odd k means cross, and even k means touch.",
      "intervalText": "Use the zeros to split the number line. Test one point in each interval. Even multiplicity does not flip the sign.",
      "complexType": "Compute the discriminant b^2 - 4ac. Negative means complex zeros; zero or positive means real zeros.",
      "complexResult": "Use FOIL: (a + bi)^2 = a^2 + 2abi + b^2i^2. Replace i^2 with -1, then combine real and imaginary parts.",
      "solutionsText": "Move everything to one side so the equation equals zero, combine like terms, factor, then use the Zero-Product Property.",
      "inequalityText": "Factor first, find the critical points, and test intervals. Strict inequalities use parentheses; non-strict inequalities include zeros with brackets or braces.",
      "transformChoice": "Compare the function to x^3 piece by piece: the number in front changes vertical stretch or reflection, inside parentheses changes horizontal shift, and the outside constant changes vertical shift.",
      "sketchExplain": "Steps: 1) list the zeros, 2) give multiplicity and cross/touch behavior, 3) use a sign chart or test points, 4) state where the polynomial is positive or negative.",
      "errorExplain": "Read the student work line by line. Check the factor signs, multiplicities, cross/touch rule, sign chart, endpoint inclusion, complex arithmetic, or transformation language."
    },
    "penalty": {
      "0": "gold",
      "1": "silver",
      "2": "bronze",
      "3": "tin"
    }
  },
