  "hints": {
    "perField": {
      "vocabAnswer": "A random process is one where all outcomes are known, but individual results are UNPREDICTABLE.",
      "termType": "OUTCOME = result of ONE trial. EVENT = a COLLECTION of outcomes (can be multiple results grouped together).",
      "independenceAnswer": "In independent events, past results do NOT affect future probabilities. Each trial has the same probability regardless of what happened before.",
      "streakAnswer": "Humans tend to think streaks are unusual, but in truly random data, streaks of 5, 6, 7, or even 8+ are actually quite COMMON.",
      "simVocabAnswer": "Simulation = model random events so that simulated outcomes closely match REAL-WORLD outcomes.",
      "llnAnswer": "Law of Large Numbers: As trials INCREASE, simulated probability gets CLOSER to the TRUE probability.",
      "digitLow": "Match the probability! If success is 82%, use digits 1-82 for success (82 out of 100).",
      "digitHigh": "The upper bound should match the probability. For 25%, use 1-25 (25 out of 100).",
      "trialAnswer": "One trial = simulating the ENTIRE scenario once. For free throws until miss: generate numbers until failure.",
      "probAnswer": "Estimated probability = (successes / total trials) × 100. Example: 16/50 = 0.32 = 32%.",
      "designDigits": "Match digits to the real probability. For 60% success: 1-60 = success, 61-100 = failure.",
      "designTrial": "Describe what happens in ONE complete simulation and what you COUNT or RECORD.",
      "capConcept": "Think about which concept (independence, LLN, simulation, random process) best explains the scenario.",
      "capExplain": "Use key vocabulary: random process, independent, Law of Large Numbers, simulation, empirical probability."
    },
    "penalty": {
