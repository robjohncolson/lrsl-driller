{
  "meta": {
    "id": "graphing-polynomials",
    "name": "Graphing Polynomials (Scaffolded Path)",
    "subject": "Algebra 2",
    "description": "18 micro-lessons that build from standard form \u2192 degree/leading coefficient \u2192 end behavior \u2192 graph features \u2192 interpretation."
  },
  "config": {
    "contextsFile": null,
    "skills": [
      "standard form",
      "degree",
      "leading coefficient",
      "end behavior",
      "function notation",
      "x-intercepts (zeros)",
      "turning points",
      "average rate of change",
      "domain & intercept meaning"
    ]
  },
  "display": {
    "showGraph": true,
    "graphType": "function-curve",
    "infoPanel": [
      {
        "label": "Level",
        "value": "{{levelName}}"
      },
      {
        "label": "Task",
        "value": "{{problemText}}"
      },
      {
        "label": "Given",
        "value": "{{givenText}}"
      },
      {
        "label": "Table",
        "value": "{{tableText}}"
      }
    ]
  },
  "modes": [
    {
      "id": "l01-polynomial-or-not",
      "name": "Level 1: Polynomial or Not?",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "isPolynomial",
            "type": "choice",
            "label": "Is this a polynomial?",
            "options": [
              "Yes",
              "No"
            ]
          }
        ]
      }
    },
    {
      "id": "l02-standard-form-select",
      "name": "Level 2: What is Standard Form?",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "standardFormPick",
            "type": "dropdown",
            "label": "Which expression is written in standard form?",
            "options": [
              "{{optA}}",
              "{{optB}}",
              "{{optC}}",
              "{{optD}}"
            ],
            "placeholder": "Choose one"
          }
        ]
      }
    },
    {
      "id": "l03-standard-form-rewrite",
      "name": "Level 3: Choose the Standard Form",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "rewrittenStandard",
            "type": "dropdown",
            "label": "Select the standard form of the expression:",
            "options": [
              "{{optA}}",
              "{{optB}}",
              "{{optC}}",
              "{{optD}}"
            ],
            "placeholder": "Choose one"
          }
        ]
      }
    },
    {
      "id": "l04-degree-of-term",
      "name": "Level 4: Degree of a Term",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "termDegree",
            "type": "number",
            "label": "What is the degree of the term?",
            "min": 0,
            "max": 12,
            "step": 1
          }
        ]
      }
    },
    {
      "id": "l05-degree-and-terms",
      "name": "Level 5: Degree & Number of Terms",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "polyDegree",
            "type": "number",
            "label": "Degree of the polynomial:",
            "min": 0,
            "max": 8,
            "step": 1
          },
          {
            "id": "numTerms",
            "type": "number",
            "label": "Number of terms (after combining like terms):",
            "min": 1,
            "max": 6,
            "step": 1
          }
        ]
      }
    },
    {
      "id": "l06-leading-coefficient",
      "name": "Level 6: Leading Coefficient",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "leadingCoeff",
            "type": "number",
            "label": "Leading coefficient:",
            "step": 0.5
          }
        ]
      }
    },
    {
      "id": "l07-missing-term",
      "name": "Level 7: Missing Term (0 Coefficient)",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "missingCoeff",
            "type": "number",
            "label": "Coefficient of the missing term ({{missingPowerText}}):",
            "step": 1
          }
        ]
      }
    },
    {
      "id": "l08-function-notation",
      "name": "Level 8: Evaluate f(x)",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "fxValue",
            "type": "number",
            "label": "Compute {{funcName}}({{inputX}}):",
            "step": 0.5
          }
        ]
      }
    },
    {
      "id": "l09-xn-quadrants",
      "name": "Level 9: Graphs of f(x)=x\u207f",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "quadrants",
            "type": "dropdown",
            "label": "Which quadrants does the graph pass through?",
            "options": [
              "Quadrants I and III",
              "Quadrants I and II",
              "Quadrants II and IV",
              "All four quadrants"
            ],
            "placeholder": "Choose one"
          }
        ]
      }
    },
    {
      "id": "l10-end-behavior-from-leading",
      "name": "Level 10: End Behavior from Leading Term",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "endBehavior",
            "type": "dropdown",
            "label": "End behavior (left end, right end):",
            "options": [
              "Both \u2191 (left \u2191, right \u2191)",
              "Both \u2193 (left \u2193, right \u2193)",
              "Left \u2193, Right \u2191",
              "Left \u2191, Right \u2193"
            ],
            "placeholder": "Choose one"
          }
        ]
      }
    },
    {
      "id": "l11-end-behavior-from-polynomial",
      "name": "Level 11: End Behavior from a Polynomial",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "endBehavior",
            "type": "dropdown",
            "label": "End behavior (left end, right end):",
            "options": [
              "Both \u2191 (left \u2191, right \u2191)",
              "Both \u2193 (left \u2193, right \u2193)",
              "Left \u2193, Right \u2191",
              "Left \u2191, Right \u2193"
            ],
            "placeholder": "Choose one"
          }
        ]
      }
    },
    {
      "id": "l12-increasing-decreasing",
      "name": "Level 12: Increasing/Decreasing from a Table",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "monotonic",
            "type": "dropdown",
            "label": "From the table, what is happening as x increases?",
            "options": [
              "Increasing",
              "Decreasing",
              "Neither (it changes direction)"
            ],
            "placeholder": "Choose one"
          }
        ]
      }
    },
    {
      "id": "l13-average-rate",
      "name": "Level 13: Average Rate of Change",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "avgRate",
            "type": "number",
            "label": "Average rate of change over [{{a}}, {{b}}]:",
            "step": 0.5
          }
        ]
      }
    },
    {
      "id": "l14-zeros-from-graph",
      "name": "Level 14: Zeros (x-intercepts) from a Graph",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "xIntercepts",
            "type": "text",
            "label": "List the x-intercepts (zeros), comma-separated:",
            "placeholder": "e.g., -3, 1, 4"
          }
        ]
      }
    },
    {
      "id": "l15-turning-points-from-graph",
      "name": "Level 15: Turning Points from a Graph",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "turningPoints",
            "type": "number",
            "label": "How many turning points are on the graph?",
            "min": 0,
            "max": 4,
            "step": 1
          }
        ]
      }
    },
    {
      "id": "l16-from-verbal",
      "name": "Level 16: From Verbal Description \u2192 x-intercepts",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "verbalIntercepts",
            "type": "text",
            "label": "From the sign changes, list the x-intercepts, comma-separated:",
            "placeholder": "e.g., -4, -1, 4"
          }
        ]
      }
    },
    {
      "id": "l17-real-world-domain",
      "name": "Level 17: Real-World Model (Domain/Intercepts)",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "interceptSense",
            "type": "choice",
            "label": "Do the x- and y-intercepts make sense in this context?",
            "options": [
              "Yes",
              "No"
            ]
          }
        ]
      }
    },
    {
      "id": "l18-capstone",
      "name": "Level 18: Concept Summary Check",
      "unlockedBy": "default",
      "layout": {
        "inputs": [
          {
            "id": "capNumTerms",
            "type": "number",
            "label": "Number of terms:",
            "min": 1,
            "max": 10,
            "step": 1
          },
          {
            "id": "capDegree",
            "type": "number",
            "label": "Degree:",
            "min": 0,
            "max": 10,
            "step": 1
          },
          {
            "id": "capLeadingCoeff",
            "type": "number",
            "label": "Leading coefficient:",
            "step": 1
          },
          {
            "id": "capEndBehavior",
            "type": "dropdown",
            "label": "End behavior:",
            "options": [
              "Both \u2191 (left \u2191, right \u2191)",
              "Both \u2193 (left \u2193, right \u2193)",
              "Left \u2193, Right \u2191",
              "Left \u2191, Right \u2193"
            ],
            "placeholder": "Choose one"
          },
          {
            "id": "capTurningPoints",
            "type": "number",
            "label": "Turning point(s):",
            "min": 0,
            "max": 4,
            "step": 1
          },
          {
            "id": "capXIntercepts",
            "type": "text",
            "label": "x-intercept(s), comma-separated:",
            "placeholder": "e.g., -4, -2, 1, 3"
          }
        ]
      }
    }
  ],
  "grading": {
    "rubricFile": "grading-rules.js",
    "aiPromptFile": "ai-grader-prompt.txt",
    "scoring": {
      "scale": [
        "E",
        "P",
        "I"
      ],
      "meanings": {
        "E": "Essentially Correct",
        "P": "Partially Correct",
        "I": "Incorrect"
      }
    }
  },
  "hints": {
    "perField": {
      "isPolynomial": "A polynomial has whole-number exponents (0,1,2,…) and no variables in denominators or radicals.",
      "standardFormPick": "Standard form lists terms by degree in descending order and combines like terms.",
      "rewrittenStandard": "Sort terms from highest power to lowest power; combine like terms.",
      "termDegree": "Degree of a one-variable term is its exponent.",
      "polyDegree": "Degree of a polynomial is the greatest exponent with a nonzero coefficient.",
      "numTerms": "Count the nonzero terms after combining like terms.",
      "leadingCoeff": "Leading coefficient is the coefficient of the highest-degree term (in standard form).",
      "missingCoeff": "If a degree is missing (no x^k term), its coefficient is 0.",
      "fxValue": "Substitute the given x-value into the function rule and simplify.",
      "quadrants": "Even powers stay ≥ 0, odd powers keep the sign of x.",
      "endBehavior": "End behavior depends on degree (even/odd) and the sign of the leading coefficient.",
      "monotonic": "Compare f(x) values: if they go up as x increases → increasing; down → decreasing.",
      "avgRate": "Average rate of change over [a,b] is (f(b)-f(a))/(b-a).",
      "xIntercepts": "x-intercepts are where the graph crosses/touches y=0 (solutions to f(x)=0).",
      "turningPoints": "Turning points are where the graph changes direction (increasing ↔ decreasing).",
      "verbalIntercepts": "Where the function changes sign (positive ↔ negative), there is an x-intercept.",
      "interceptSense": "In real contexts, check whether negative x or negative y makes sense; you may need to limit domain/range.",
      "capNumTerms": "Count the nonzero terms in the polynomial (as written).",
      "capDegree": "Highest exponent with nonzero coefficient.",
      "capLeadingCoeff": "Coefficient of x^degree (leading term).",
      "capEndBehavior": "Degree parity + leading coefficient sign → end behavior.",
      "capTurningPoints": "Use the graph: count the direction changes.",
      "capXIntercepts": "Look where the graph intersects the x-axis (y=0)."
    },
    "penalty": {
      "0": "gold",
      "1": "silver",
      "2": "bronze",
      "3": "tin"
    }
  },
  "progression": {
    "streaksPerField": false,
    "streakFields": [
      "endBehavior",
      "xIntercepts",
      "turningPoints",
      "avgRate"
    ],
