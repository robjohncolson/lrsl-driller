      "slope-calculation",
      "intercept-calculation",
      "standard-deviation",
      "full-lsrl",
      "zscore-comparison"
    ]
  },
  "display": {
    "showGraph": true,
    "graphType": "normal-curve",
    "showFormulaReference": true,
    "formulaPanel": {
      "zscore": "z = (x − μ) / σ",
      "rawValue": "x = μ + z · σ",
      "slope": "b = r · (sᵧ / sₓ)",
      "intercept": "a = ȳ − b · x̄",
      "stdDev": "s = √[Σ(xᵢ − x̄)² / (n − 1)]"
    },
