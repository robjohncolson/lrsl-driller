  "meta": {
    "id": "lsrl-calculations",
    "name": "LSRL & Z-Score Calculations",
    "subject": "AP Statistics",
    "unit": "1-2",
    "lesson": "5-8",
    "skill": "Calculate z-scores, slope (b), y-intercept (a), and standard deviation using formulas",
    "description": "Students practice computational skills: z = (x-μ)/σ, b = r(sᵧ/sₓ), a = ȳ - bx̄, and s = √[Σ(x-x̄)²/(n-1)]"
  },
